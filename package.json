{
  "name": "ui-patterns",
  "version": "0.4.0",
  "description": "A catalogue of accessible, design agnostic best practice user interface patterns",
  "scripts": {
    "build": "rspack build --config tools/rspack/config/build/index.js",
    "ci": "rspack build --config tools/rspack/config/integration/index.js",
    "dev": "rspack serve --config tools/rspack/config/dev/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "npm run dev",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "node --import ./tools/testing/register.mjs --test",
    "watch": "npm run watch-dev",
    "watch-dev": "rspack build --config tools/rspack/config/integration/index.js --watch"
  },
  "author": "stormid",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.64.1",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.13.3",
    "browserslist": "^4.29.4",
    "css-loader": "^7.1.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.89.0",
    "preact": "^11.0.1",
    "preact-render-to-string": "^6.8.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0"
  },
  "dependencies": {
    "@scottish-government/design-system": "^4.3.0",
    "@stormid/cookie-banner": "^1.0.3",
    "@stormid/modal": "^1.1.0",
    "@stormid/tabs": "^2.0.1",
    "@stormid/toggle": "^1.1.1",
    "@stormid/validate": "^2.2.0"
  }
}
